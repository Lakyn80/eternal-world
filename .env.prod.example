COMPOSE_PROJECT_NAME=eternal-world

BACKEND_IMAGE=ghcr.io/lakyn80/eternal-world-backend:latest
FRONTEND_IMAGE=ghcr.io/lakyn80/eternal-world-frontend:latest
BACKEND_HOST_PORT=8033
FRONTEND_HOST_PORT=3017
SHARED_HF_VOLUME=shared_huggingface_cache

POSTGRES_DB=eternal_world
POSTGRES_USER=eternal_user
POSTGRES_PASSWORD=change-me

APP_NAME=Eternal World API
ENVIRONMENT=staging
SQLALCHEMY_ECHO=false
BACKEND_CORS_ORIGINS=https://eternalworld.lukiora.ru

JWT_SECRET_KEY=change-me-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=eternal-world
JWT_AUDIENCE=eternal-world-api

AI_BRAIN_PROVIDER=openai_compatible
AI_BRAIN_BASE_URL=https://api.openai.com/v1
AI_BRAIN_MODEL=gpt-4.1-mini
AI_BRAIN_API_KEY=change-me
AI_BRAIN_TIMEOUT_SECONDS=30

CONTENT_TRANSLATION_PROVIDER=openai_compatible
CONTENT_TRANSLATION_BASE_URL=https://api.openai.com/v1
CONTENT_TRANSLATION_MODEL=gpt-4.1-mini
CONTENT_TRANSLATION_API_KEY=change-me
CONTENT_TRANSLATION_TIMEOUT_SECONDS=20
CONTENT_TRANSLATION_MAX_RETRIES=1

EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMERS_DEVICE=cpu
QDRANT_COLLECTION_NAME=eternal_world_rag_chunks
QDRANT_TIMEOUT_SECONDS=10
QDRANT_INDEXING_ENABLED=true

MEDIA_STORAGE_PROVIDER=local
MEDIA_MAX_FILE_SIZE_BYTES=20971520

CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

NEXT_PUBLIC_API_URL=https://eternalworld.lukiora.ru/api
