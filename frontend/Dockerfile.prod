FROM node:22-alpine AS deps

WORKDIR /app/react-export

COPY react-export/package.json react-export/package-lock.json* ./

RUN npm install

FROM node:22-alpine AS build

WORKDIR /app/react-export

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

COPY --from=deps /app/react-export/node_modules ./node_modules
COPY react-export/ ./

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app/react-export

ENV NODE_ENV=production \
    PORT=3000

COPY --from=build /app/react-export/package.json ./package.json
COPY --from=build /app/react-export/node_modules ./node_modules
COPY --from=build /app/react-export/dist ./dist

EXPOSE 3000

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]
