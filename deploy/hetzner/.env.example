# Hetzner production environment template.
# Copy to /opt/eternal-world/.env.prod on the server and fill real values.
# Never commit a real .env.prod.

COMPOSE_PROJECT_NAME=eternal-world-hetzner

# Immutable GHCR tags (set by the deploy workflow to the commit SHA).
BACKEND_IMAGE=ghcr.io/lakyn80/eternal-world-backend:REPLACE_WITH_FULL_GIT_SHA
FRONTEND_IMAGE=ghcr.io/lakyn80/eternal-world-frontend:REPLACE_WITH_FULL_GIT_SHA

# Loopback-only ports for host Nginx (chosen to avoid colliding with common
# services and with the Russian install's 8033/3017 convention on that host).
BACKEND_HOST_PORT=8133
FRONTEND_HOST_PORT=3117

# Host-wide Hugging Face model cache (same name as Russia / other AI projects).
SHARED_HF_VOLUME=shared_huggingface_cache

# PostgreSQL — unique credentials for this installation only.
POSTGRES_DB=eternal_world_hetzner
POSTGRES_USER=eternal_hetzner
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

APP_NAME=Eternal World API
ENVIRONMENT=production
SQLALCHEMY_ECHO=false
BACKEND_CORS_ORIGINS=https://eternal.world.lukiora.com

JWT_SECRET_KEY=REPLACE_WITH_STRONG_UNIQUE_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=eternal-world
JWT_AUDIENCE=eternal-world-api

# AI providers — use Hetzner-specific keys; do not reuse Russian secrets.
AI_BRAIN_PROVIDER=openai_compatible
AI_BRAIN_BASE_URL=https://api.deepseek.com
AI_BRAIN_MODEL=deepseek-chat
AI_BRAIN_API_KEY=REPLACE_WITH_HETZNER_AI_KEY
AI_BRAIN_TIMEOUT_SECONDS=30

CONTENT_TRANSLATION_PROVIDER=openai_compatible
CONTENT_TRANSLATION_BASE_URL=https://api.deepseek.com
CONTENT_TRANSLATION_MODEL=deepseek-chat
CONTENT_TRANSLATION_API_KEY=REPLACE_WITH_HETZNER_TRANSLATION_KEY
CONTENT_TRANSLATION_TIMEOUT_SECONDS=20
CONTENT_TRANSLATION_MAX_RETRIES=1

EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMERS_DEVICE=cpu
QDRANT_COLLECTION_NAME=eternal_world_hetzner_rag_chunks
QDRANT_TIMEOUT_SECONDS=10
QDRANT_INDEXING_ENABLED=true

MEDIA_STORAGE_PROVIDER=local
MEDIA_MAX_FILE_SIZE_BYTES=20971520
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

# Frontend production image is built with empty VITE_API_URL (same-origin).
# This value is kept for documentation / local tooling only.
VITE_API_URL=
